{
  "name": "broadcast",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "web",
    "functions"
  ],
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "test:auth": "npm run test:auth --workspace web",
    "dev": "npm run dev --workspace web",
    "emulators": "npm run build --workspace functions && node scripts/start-emulators.mjs",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "npm run lint --workspace web",
    "firebase": "firebase"
  },
  "devDependencies": {
    "firebase-tools": "^15.32.1"
  }
}
